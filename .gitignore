# Images generated by Gemini are never committed. save_dir is outside the repo by default
# (enforced in image_store.py); these rules are a safety net if a file is copied in.
gemini-[0-9]*-[0-9]*-*.png
gemini-[0-9]*-[0-9]*-*.jpg
gemini-[0-9]*-[0-9]*-*.jpeg
gemini-[0-9]*-[0-9]*-*.webp
